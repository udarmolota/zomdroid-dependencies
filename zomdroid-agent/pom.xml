<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.zomdroid</groupId>
    <artifactId>zomdroid-agent</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <!-- Pinned: relocation has to reach the classes under META-INF/versions too (Byte
                     Buddy's Java 24+ bridge lives only there, see below), which older shade
                     releases did not do. Unpinned, the version was whatever Maven resolved. -->
                <version>3.6.0</version>
                <!-- Relocating means shade parses every class with ASM, and the ASM it brings
                     stops below Java 24 - Byte Buddy's versions/24 bridge is major version 68, so
                     the build failed with "Unsupported class file major version 68". Before the
                     relocation shade only copied entries and never looked inside. ASM 9.8 reads
                     up to Java 25. -->
                <dependencies>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.8</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>9.8</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <minimizeJar>true</minimizeJar>
                            <!--
                              No multi-release copies. Shade relocates the base classes but left
                              every class under META-INF/versions/9 and /24 at its old name
                              net.bytebuddy.*: the Java 24+ bridge became unreachable for our
                              relocated code (the agent would install no hooks on Build 42.20, the
                              way quick save once shipped as a dead button), and the old names stayed
                              visible to mods, so the collision with ZombieBuddy was only half gone.
                              The agent runs Byte Buddy on its plain ASM reader instead (ASM_ONLY,
                              set in Main), which 1.17.7 can do for Java 25. Multi-Release is off.
                            -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/versions/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!--
                              Our copies of Byte Buddy and ANTLR live under our own package names.
                              The agent is on the system class path through -javaagent, so plain
                              net.bytebuddy.* classes from this jar shadowed the Byte Buddy every
                              mod framework brings along. ZombieBuddy ships a newer one; ours (then 1.17.4)
                              cannot read Java 25 class files, and PZ3D, compiled for Java 25, lost
                              every one of its patches with "Unsupported class file major version
                              69" (2026-09-27). The same collision is why ZBBetterFPS once had to be
                              rebuilt for Java 21. Relocated, each side uses its own copy.
                            -->
                            <relocations>
                                <relocation>
                                    <pattern>net.bytebuddy</pattern>
                                    <shadedPattern>com.zomdroid.shaded.net.bytebuddy</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.antlr</pattern>
                                    <shadedPattern>com.zomdroid.shaded.org.antlr</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Agent-Class>com.zomdroid.agent.Main</Agent-Class>
                                        <Premain-Class>com.zomdroid.agent.Main</Premain-Class>
                                        <Can-Redefine-Classes>true</Can-Redefine-Classes>
                                        <Can-Retransform-Classes>true</Can-Retransform-Classes>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <finalName>zomdroid-agent</finalName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <!-- 1.17.5+ carries ASM 9.8, which reads Java 25 class files (Build 42.20 is major
                 version 69) on its own, so the agent no longer needs the Class File API bridge
                 that lives only under META-INF/versions/24. See the shade filter above. -->
            <version>1.17.7</version>
        </dependency>
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>4.13.2</version> <!-- Check for latest version -->
        </dependency>
    </dependencies>
</project>