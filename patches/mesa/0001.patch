 #include "zink_descriptors.h"
 #include "zink_kopper.h"
 #include "zink_program.h"
@@ -228,6 +229,114 @@ zink_batch_reset_all(struct zink_context *ctx)
    }
 }
 
+/* RimDroid: eagerly reset COMPLETED batch states from the head of the list, releasing their
+ * staging BOs / resource refs NOW instead of on lazy reuse. Mirrors the reuse conditions in
+ * get_batch_state exactly (submitted + last_finished/completed, head only, never the last
+ * in-flight state) — so it frees only what upstream itself considers reusable. Called from the
+ * end of zink_flush: RimWorld 1.6 uploads ~1.3GB inside one frame and the lazily-recycled
+ * staging piles up to gigabytes, LMK-killing the app on Android. */
+extern uint64_t rd_free_total;
+void
+zink_reap_completed_batch_states(struct zink_context *ctx)
+{
+   struct zink_screen *screen = zink_screen(ctx->base.screen);
+   unsigned reaped = 0;
+   uint64_t freed_before = rd_free_total;
+   /* OWNER-THREAD ONLY: zink_fence_finish flushes a fence's deferred_ctx from whatever thread
+      waits on it, so zink_flush (and thus this reaper) can run on a foreign thread concurrently
+      with the owner. Upstream's head-pop tolerates that race; walking and unlinking mid-list
+      does not (corrupted list -> waiter waits on an unlinked node -> permanent freeze, seen at
+      ~35s into loading). Register the first flushing thread as the owner and skip all others. */
+   {
+      static struct { struct zink_context *ctx; pthread_t tid; } rd_owner[8];
+      static simple_mtx_t rd_owner_mtx = SIMPLE_MTX_INITIALIZER;
+      pthread_t self = pthread_self();
+      bool owner = false;
+      simple_mtx_lock(&rd_owner_mtx);
+      for (unsigned i = 0; i < ARRAY_SIZE(rd_owner); i++) {
+         if (rd_owner[i].ctx == ctx) {
+            owner = pthread_equal(rd_owner[i].tid, self);
+            break;
+         }
+         if (!rd_owner[i].ctx) {
+            rd_owner[i].ctx = ctx;
+            rd_owner[i].tid = self;
+            owner = true;
+            break;
+         }
+      }
+      simple_mtx_unlock(&rd_owner_mtx);
+      if (!owner) {
+         static unsigned rd_foreign;
+         if (++rd_foreign % 1024 == 1)
+            mesa_logw("RDZFA reap: skipped foreign-thread flush #%u ctx=%p", rd_foreign, (void*)ctx);
+         return;
+      }
+   }
+   /* SCAN-PAST-HEAD (brief v15): upstream recycles strictly from the list head, so one stuck
+      state poisons the whole list (measured: 1.45M live states, 0 reused). Walk the list and
+      unlink ANY submitted+completed state; never touch unsubmitted/incomplete ones and never
+      the tail (mirrors upstream's ->next guard). */
+   struct zink_batch_state **prev = &ctx->batch_states;
+   struct zink_batch_state *cur = ctx->batch_states;
+   while (cur && cur->next) {
+      if (p_atomic_read(&cur->fence.submitted) &&
+          /* STRICT timeline confirmation only, and no outstanding tc-fences: reaping a state
+             whose fence/query results are still being observed stalls the app (seen: loading
+             froze while a thread polled forever). */
+          zink_screen_check_last_finished(screen, cur->fence.batch_id) &&
+          !util_dynarray_num_elements(&cur->fence.mfences, struct zink_tc_fence *) &&
+          /* the context's pending deferred fence may reference a state's fence without an
+             mfence entry — resetting it under the waiter stalls loading (seen at tex=544MB) */
+          ctx->deferred_fence != &cur->fence) {
+         struct zink_batch_state *bs = cur;
+         *prev = cur->next;
+         cur = cur->next;
+         ctx->batch_states_count--;
+         if (ctx->last_batch_state == bs)
+            ctx->last_batch_state = NULL;
+         zink_reset_batch_state(ctx, bs);
+         if (ctx->last_free_batch_state)
+            ctx->last_free_batch_state->next = bs;
+         else
+            ctx->free_batch_states = bs;
+         ctx->last_free_batch_state = bs;
+         bs->next = NULL;
+         reaped++;
+      } else {
+         prev = &cur->next;
+         cur = cur->next;
+      }
+   }
+   /* One-shot head autopsy whenever the list is badly backed up: WHY is the head stuck? */
+   {
+      static unsigned rd_autopsy_at = 64;
+      if (ctx->batch_states && ctx->batch_states_count >= rd_autopsy_at) {
+         struct zink_batch_state *h = ctx->batch_states;
+         mesa_logw("RDZFA head-autopsy: count=%u submitted=%d completed=%d batch_id=%u last_finished_ok=%d has_work=%d",
+                   ctx->batch_states_count,
+                   (int)p_atomic_read(&h->fence.submitted),
+                   (int)p_atomic_read(&h->fence.completed),
+                   (unsigned)h->fence.batch_id,
+                   (int)zink_screen_check_last_finished(screen, h->fence.batch_id),
+                   (int)h->has_work);
+         rd_autopsy_at *= 4;
+      }
+   }
+   {
+      /* Log live batch-state count on every reap attempt (rate-limited by change): if the count
+         grows unbounded during the atlas bake, Turnip CS chunks pile up inside them (the ~4MB
+         kgsl BO flood bypassing zink accounting). */
+      static unsigned rd_last_cnt = 0;
+      if (reaped || ctx->batch_states_count != rd_last_cnt) {
+         rd_last_cnt = ctx->batch_states_count;
+         mesa_logw("RDZFA reap: %u reaped, live_states=%u, freed %uMB ctx=%p",
+                   reaped, ctx->batch_states_count, (unsigned)((rd_free_total - freed_before) >> 20),
+                   (void*)ctx);
+      }
+   }
+}
