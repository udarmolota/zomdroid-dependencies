diff --git b/src/gl/pz_skinattrib.h b/src/gl/pz_skinattrib.h
new file mode 100644
index 0000000..472cfe5
--- /dev/null
+++ b/src/gl/pz_skinattrib.h
@@ -0,0 +1,22 @@
+#ifndef ZOMDROID_PZ_SKINATTRIB_H
+#define ZOMDROID_PZ_SKINATTRIB_H
+
+#include <string.h>
+
+/* Compatibility-profile PZ skinning mixes conventional and generic arrays.
+ * GL4ES aliases their storage, including the conventional colour slot (3).
+ * Slots 6/7 are unused by its ARB conventional-array mapping. Do not use
+ * them on the <=8-attribute compressed mapping, where they are texcoords.
+ */
+static int pz_skinattrib_eligible(const char *source, int maxattrib,
+                                int indices_bound, int weights_bound,
+                                int slot6_used, int slot7_used)
+{
+    return source && maxattrib > 8 && !indices_bound && !weights_bound &&
+        !slot6_used && !slot7_used &&
+        strstr(source, "gl_Vertex") && strstr(source, "gl_Normal") &&
+        strstr(source, "MatrixPalette") && strstr(source, "boneIndices") &&
+        strstr(source, "boneWeights");
+}
+
+#endif
