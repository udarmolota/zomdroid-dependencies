@@ -986,8 +986,21 @@ void APIENTRY_GL4ES gl4es_glRenderbufferStorage(GLenum target, GLenum internalfo
     // check if internal format is GL_DEPTH_STENCIL_EXT
     if (internalformat == GL_DEPTH_STENCIL)
         internalformat = GL_DEPTH24_STENCIL8;
+    // Old PowerVR drivers need the split fallback even when they advertise the packed format.
+    // B-Series does not: splitting a packed buffer into separate depth/stencil attachments makes
+    // its driver reject PZ B41's character-combiner FBO with GL_FRAMEBUFFER_UNSUPPORTED.
+    const int split_imgtec_depthstencil =
+        ((hardext.vendor & VEND_IMGTEC) == VEND_IMGTEC) && !hardext.imgtec_bseries;
+    if (internalformat == GL_DEPTH24_STENCIL8 && hardext.imgtec_bseries && hardext.depthstencil) {
+        static int packed_bseries_logged = 0;
+        if (!packed_bseries_logged) {
+            SHUT_LOGD("PowerVR B-Series: keeping packed GL_DEPTH24_STENCIL8 renderbuffers\n");
+            packed_bseries_logged = 1;
+        }
+    }
     // in that case, create first a STENCIL one then a DEPTH one....
-    if ((internalformat == GL_DEPTH24_STENCIL8 && (hardext.depthstencil==0 || ((hardext.vendor&VEND_IMGTEC)==VEND_IMGTEC)))) {
+    if (internalformat == GL_DEPTH24_STENCIL8 &&
+        (hardext.depthstencil == 0 || split_imgtec_depthstencil)) {
         internalformat = (hardext.depth24)?GL_DEPTH_COMPONENT24:GL_DEPTH_COMPONENT16;
         // create a stencil buffer if needed
         if(!rend->secondarybuffer) {
diff --git a/src/glx/hardext.c b/src/glx/hardext.c
